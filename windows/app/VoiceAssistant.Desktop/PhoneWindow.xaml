<Window x:Class="VoiceAssistant.Desktop.PhoneWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="휴대폰 연결 · 무료" Width="590" Height="700" MinHeight="600" MinWidth="520" WindowStartupLocation="CenterOwner" Background="{StaticResource CanvasBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30">
  <TextBlock x:Name="PhoneHeading" Text="휴대폰에서 PC에 부탁하세요" FontSize="24" FontWeight="SemiBold" />
  <TextBlock x:Name="PhoneIntro" Text="LTE·5G·다른 와이파이에서도 브라우저로 연결" Style="{StaticResource HelpText}" Margin="0,10,0,22" />
  <TextBlock Text="1. 연결 방식 선택" FontSize="16" FontWeight="SemiBold" />
  <ComboBox x:Name="ModeInput" SelectedIndex="0" Margin="0,12,0,0" AutomationProperties.Name="휴대폰 연결 방식"><ComboBoxItem Content="인터넷 · 다른 네트워크 + 음성 입력"/><ComboBoxItem Content="같은 와이파이 · 로컬 연결"/></ComboBox>
  <ComboBox x:Name="NetworkInput" DisplayMemberPath="Label" Margin="0,12,0,8" AutomationProperties.Name="휴대폰 연결 네트워크" />
  <WrapPanel><Button x:Name="StartButton" Content="연결 켜기" Style="{StaticResource ActionButton}" Click="Start_Click" Padding="16,10" /><Button x:Name="StopButton" Content="연결 끄기" IsEnabled="False" Style="{StaticResource SecondaryButton}" Click="Stop_Click" Padding="16,10" Margin="8,0,0,0" /><Button x:Name="ResetButton" Content="새 코드 · 연결 초기화" IsEnabled="False" Style="{StaticResource SecondaryButton}" Click="Reset_Click" Padding="12,10" Margin="8,0,0,0" /></WrapPanel>
  <TextBlock Text="2. 휴대폰 브라우저에서 이 주소 열기" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,10" />
  <TextBox x:Name="AddressText" IsReadOnly="True" Text="연결을 켜면 주소가 나옵니다." Style="{StaticResource Field}" FontSize="18" AutomationProperties.Name="휴대폰 접속 주소" />
  <TextBlock Text="3. 휴대폰에 연결 코드 입력" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,10" />
  <TextBox x:Name="CodeText" IsReadOnly="True" Text="—" Style="{StaticResource Field}" FontSize="28" FontWeight="SemiBold" HorizontalContentAlignment="Center" AutomationProperties.Name="휴대폰 연결 코드" />
  <TextBlock x:Name="StatusText" Text="연결 꺼짐" TextWrapping="Wrap" Margin="0,14,0,14" Foreground="#315DE7" AutomationProperties.Name="무료 휴대폰 연결 상태" />
  <TextBlock Style="{StaticResource HelpText}" Text="코드는 10분 동안, 연결은 최대 8시간 유효합니다. 초기화하면 모든 휴대폰 연결과 진행 중인 휴대폰 요청이 취소됩니다. 앱을 다시 실행하면 연결은 꺼진 상태로 시작합니다. 인터넷 연결의 명령과 답변은 HTTPS 중계 서버를 거칩니다." TextWrapping="Wrap" />
  <Expander Header="연결이 안 될 때 · 사용 안내" Margin="0,20,0,0"><TextBlock Margin="0,10,0,0" Style="{StaticResource HelpText}" TextWrapping="Wrap" Text="인터넷 모드: PC와 폰에서 sasarisa.xsw.kr 접속이 허용되어야 합니다. 같은 네트워크일 필요는 없으며 공유기 포트포워딩도 필요 없습니다.&#x0a;폰의 음성 입력 버튼은 브라우저의 마이크 권한이 필요합니다. 갤럭시는 Chrome, 아이폰은 Safari를 사용하세요. 브라우저 제공업체의 음성 인식 서비스를 사용할 수 있습니다.&#x0a;&#x0a;로컬 모드: PC와 폰을 같은 공유기에 연결하세요. Windows 방화벽이 물으면 신뢰하는 개인 네트워크에서 이 앱의 접근을 허용하세요. 방화벽 전체를 끌 필요는 없습니다.&#x0a;HTTP 연결이므로 신뢰하는 집·사무실 네트워크에서만 켜세요. 주소가 바뀌면 연결을 다시 켜세요. 키보드의 마이크로 입력한 내용을 보낼 수 있습니다.&#x0a;&#x0a;AI 답변은 PC에서 선택한 서비스의 요금을 따릅니다." /></Expander>
 </StackPanel></ScrollViewer>
</Window>
