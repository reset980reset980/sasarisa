<Window x:Class="VoiceAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자비스 · Windows" Width="1080" Height="760" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#172338">
            <Grid Margin="20,30,20,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="7,0,0,35">
                    <Grid Width="46" Height="46" HorizontalAlignment="Left" Margin="0,0,0,19">
                        <Ellipse Fill="#315DE7" />
                        <Ellipse Width="19" Height="19" Fill="#ECF1FF" />
                        <Ellipse Width="7" Height="7" Fill="#315DE7" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="BrandNameText" Text="자비스" Foreground="White" FontSize="27" FontWeight="SemiBold" MaxHeight="70" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="YOUR WINDOWS ASSISTANT" Foreground="#93A5C2" FontSize="9" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button x:Name="ChatNav" Style="{StaticResource NavButton}" Click="ChatNav_Click" Background="#2B3A55" Foreground="White"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" Margin="0,0,13,0" /><TextBlock Text="대화" /></StackPanel></Button>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,13,0" /><TextBlock Text="설정" /></StackPanel></Button>
                    <Button x:Name="HelpNav" Style="{StaticResource NavButton}" Click="HelpNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Margin="0,0,13,0" /><TextBlock Text="사용 방법" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Border Background="#223149" CornerRadius="12" Padding="14" Margin="0,0,0,21">
                        <StackPanel>
                            <TextBlock Text="바로 말하기" Foreground="#DBE4F4" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock x:Name="HotkeyHintText" Text="Ctrl + Shift + Space" Foreground="White" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0" />
                            <TextBlock Text="마이크를 켠 뒤 단축키로&#x0a;바로 명령을 시작하세요." Foreground="#A4B2C9" FontSize="11" LineHeight="17" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="BrainStatusText" Text="AI 연결 확인 중" Foreground="#A8B8D0" FontSize="11" Margin="7,0,0,14" />
                    <Button Style="{StaticResource NavButton}" Click="QuitButton_Click" FontSize="12" Padding="7,8" Margin="0,0,0,12" ToolTip="마이크와 실행 중인 도우미를 종료합니다."><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" /><TextBlock Text="앱 종료" /></StackPanel></Button>
                    <TextBlock Text="Based on Sasarisa" Foreground="#90A0BB" FontSize="10" Margin="7,0,0,0" />
                    <TextBlock Text="WINDOWS EDITION · LOCAL FIRST" Foreground="#8C9DB7" FontSize="9" Margin="7,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="30,28,30,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,23">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="A LITTLE HELP, EVERY DAY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageTitle" Text="무엇을 도와드릴까요?" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12,6" VerticalAlignment="Top" Margin="12,7,0,0">
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#8D98A9" Width="6" Height="6" Margin="0,0,7,0" /><TextBlock x:Name="StatusPill" Text="마이크 꺼짐" FontSize="11" /></StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="ChatPage" Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="22,20" Margin="0,0,0,19">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid Margin="0,0,15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="17" VerticalAlignment="Center" Margin="0,0,9,0" /><TextBlock x:Name="StatusTitle" Grid.Column="1" Text="말할 준비가 되셨나요?" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /></Grid>
                            <TextBlock x:Name="StatusDetail" Text="듣기 시작을 누르면 호출 이름을 기다립니다." Foreground="{StaticResource MutedBrush}" Margin="0,8,15,0" FontSize="12" TextWrapping="Wrap" />
                            <Grid Margin="0,16,25,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="입력 음량" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,11,0" /><ProgressBar x:Name="MicLevel" Grid.Column="1" Maximum="1" Height="5" VerticalAlignment="Center" Foreground="#315DE7" Background="#E9EDF5" BorderThickness="0" /></Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="ListenButton" Style="{StaticResource ActionButton}" Content="듣기 시작" MinWidth="112" Click="ListenButton_Click" />
                            <Button x:Name="WakeButton" Style="{StaticResource SecondaryButton}" Content="지금 말하기" MinWidth="112" Margin="0,8,0,0" Padding="12,7" Click="WakeButton_Click" ToolTip="호출 이름을 기다리지 않고 바로 듣습니다." />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10"><TextBlock Text="대화 기록" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="이 창에서 나눈 대화" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" /></Grid>
                    <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel x:Name="HistoryPanel">
                            <Border x:Name="WelcomeCard" Background="#EDF1FA" CornerRadius="13" Padding="23" Margin="0,2,0,12">
                                <StackPanel>
                                    <TextBlock Text="작은 일부터 맡겨보세요." FontSize="19" FontWeight="SemiBold" Margin="0,0,0,9" />
                                    <TextBlock Text="앱을 열거나, 궁금한 것을 묻거나, 생각을 정리해 보세요.&#x0a;마이크 없이 아래에 입력해서 시작할 수도 있어요." Foreground="#596984" FontSize="12" LineHeight="21" />
                                    <WrapPanel Margin="0,17,0,0"><Button Content="메모장 열어" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="11,7" Margin="0,0,8,7" Click="Suggestion_Click" /><Button Content="5분 타이머" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="11,7" Margin="0,0,8,7" Click="Suggestion_Click" /><Button Content="할 수 있는 일 알려줘" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="11,7" Margin="0,0,0,7" Click="Suggestion_Click" /></WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Border Grid.Row="2" x:Name="PartialBorder" Background="#EAF0FF" CornerRadius="8" Padding="12,9" Margin="0,8,0,9" Visibility="Collapsed">
                    <TextBlock x:Name="PartialText" Foreground="#365AA4" FontSize="12" />
                </Border>
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <Border Background="White" BorderBrush="#CCD5E5" BorderThickness="1" CornerRadius="12" Padding="6">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="CommandInput" Style="{StaticResource Field}" Background="White" BorderThickness="0" FontSize="13" MinHeight="43" MaxHeight="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" PreviewKeyDown="CommandInput_PreviewKeyDown" AutomationProperties.Name="명령 입력" ToolTip="명령을 입력하세요. Enter로 보내기, Shift+Enter로 줄바꿈" />
                            <TextBlock x:Name="InputPlaceholder" Text="명령을 입력하세요…" Foreground="#8994A5" IsHitTestVisible="False" Margin="11,13,5,0" VerticalAlignment="Top" />
                            <Button x:Name="StopButton" Grid.Column="1" Content="중지" Style="{StaticResource SecondaryButton}" Click="StopButton_Click" IsEnabled="False" Padding="12,8" Margin="2,0,6,0" VerticalAlignment="Bottom" />
                            <Button Grid.Column="2" Content="보내기  ↗" Style="{StaticResource ActionButton}" Click="SendButton_Click" Padding="15,11" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                    <Grid Margin="3,9,3,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="TimerNotice" Text="마이크는 듣기 시작을 누른 뒤에 켜집니다." FontSize="10" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="Enter 보내기 · Shift+Enter 줄바꿈" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" /></Grid>
                </StackPanel>
            </Grid>
            <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,11,0">
                    <StackPanel>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="22" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="목소리로 시작하기" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="호출과 명령 인식의 감도를 사용 환경에 맞게 조절합니다." Style="{StaticResource HelpText}" Margin="0,6,0,20" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="호출 이름" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NameInput" Text="자비스" Style="{StaticResource Field}" /><TextBlock Text="짧고 분명하게 발음할 수 있는 이름" Style="{StaticResource HelpText}" /><Button Content="내 목소리로 이름 맞추기" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,6" Style="{StaticResource SecondaryButton}" Click="NameTraining_Click" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="호출 방식" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ActivationInput" SelectedIndex="0"><ComboBoxItem Content="이름을 부르거나 단축키" Tag="voice" /><ComboBoxItem Content="단축키로만 호출" Tag="hotkey" /><ComboBoxItem Content="키를 누르는 동안만 듣기" Tag="hold" /></ComboBox><TextBlock x:Name="SettingsHotkeyHelp" Text="Ctrl + Shift + Space로 바로 말하기" Style="{StaticResource HelpText}" /></StackPanel>
                                </Grid>
                                <TextBlock Text="입력 마이크" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="DeviceInput" DisplayMemberPath="Label" SelectedValuePath="Id" /><Button Grid.Column="1" Content="새로고침" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="9,0,0,0" Click="RefreshDevices_Click" /></Grid>
                                <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="말 끝 대기 시간 (초)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SilenceInput" Text="1.2" Style="{StaticResource Field}" /><TextBlock Text="말을 멈춘 뒤 명령을 확정하는 시간 · 0.4–3" Style="{StaticResource HelpText}" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="후속 대화 유지 (초)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="FollowUpInput" Text="30" Style="{StaticResource Field}" /><TextBlock Text="답변 뒤 이름 없이 이어 말할 수 있는 시간 · 5–120" Style="{StaticResource HelpText}" /></StackPanel>
                                </Grid>
                                <CheckBox x:Name="PauseInCallsInput" Content="다른 앱이 마이크를 사용하면 자동 듣기 대기" IsChecked="True" Margin="0,22,0,0" VerticalContentAlignment="Center" /><TextBlock Text="통화·녹음이 끝나면 다시 듣습니다. 대기 중에도 단축키나 ‘지금 말하기’로 한 번 말할 수 있어요." Style="{StaticResource HelpText}" TextWrapping="Wrap" />
                                <CheckBox x:Name="SpeakInput" Content="답변을 음성으로 읽기" IsChecked="True" Margin="0,22,0,0" VerticalContentAlignment="Center" />
                                <TextBlock Text="답변 중 끼어들기" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                                <ComboBox x:Name="BargeInInput" SelectedIndex="0"><ComboBoxItem Content="자동 · 출력 장치에 맞춰 감지" Tag="auto" /><ComboBoxItem Content="어떤 말이든 · 헤드셋 사용 시" Tag="any" /><ComboBoxItem Content="이름이나 ‘그만’으로 끼어들기" Tag="wake" /><ComboBoxItem Content="끄기 · 버튼이나 단축키로 중지" Tag="off" /></ComboBox>
                                <TextBlock Text="마이크가 켜져 있어야 합니다. 자동은 헤드셋에서는 말을 감지하고, 스피커에서는 호출어·중지 말과 반향보다 큰 목소리를 확인합니다. 키를 누르는 동안만 듣기는 단축키를 사용하세요." Style="{StaticResource HelpText}" TextWrapping="Wrap" />
                                <Expander Header="목소리와 출력 장치" Margin="0,14,0,0">
                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock x:Name="VoiceProviderSummary" Text="Windows 기본 음성" FontWeight="SemiBold" />
                                        <Button Content="음성 제공자 설정" Style="{StaticResource SecondaryButton}" Padding="12,7" HorizontalAlignment="Left" Margin="0,7,0,14" Click="VoiceProviderSettings_Click" />
                                        <Button Content="Pro 계정 연결·사용량" Style="{StaticResource SecondaryButton}" Padding="12,7" HorizontalAlignment="Left" Margin="0,0,0,14" Click="ProAccount_Click" />
                                        <TextBlock Text="Windows 기본 / 대체 목소리" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="VoiceInput" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        <TextBlock Text="답변을 들을 스피커 / 헤드셋" Style="{StaticResource FieldLabel}" Margin="0,15,0,7" /><ComboBox x:Name="OutputInput" DisplayMemberPath="Label" SelectedValuePath="Id" />
                                        <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Windows 읽기 속도 (-5~5)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SpeechRateInput" Text="0" Style="{StaticResource Field}" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="답변 음량 (0~100)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SpeechVolumeInput" Text="85" Style="{StaticResource Field}" /></StackPanel>
                                        </Grid>
                                        <TextBlock Text="답변 음량은 비서 목소리에만 적용됩니다. 장치를 연결한 뒤 앱을 다시 열면 목록이 갱신됩니다." Style="{StaticResource HelpText}" />
                                    </StackPanel>
                                </Expander>
                                <Button Content="목소리 들어보기" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="12,7" FontSize="11" Margin="0,11,0,0" Click="SpeakTest_Click" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="22" Margin="0,0,0,14">
                            <StackPanel>
                                <Expander Header="단축키와 알림 위치" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,24">
                                    <StackPanel Margin="0,18,0,0" TextElement.FontWeight="Normal" TextElement.FontSize="12">
                                        <TextBlock Text="아래 칸을 누른 뒤 사용할 키 조합을 누르세요. 저장하면 전역 단축키로 적용됩니다." Style="{StaticResource HelpText}" />
                                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="말하기 단축키" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WakeHotkeyInput" IsReadOnly="True" Style="{StaticResource Field}" PreviewKeyDown="HotkeyInput_PreviewKeyDown" AutomationProperties.Name="말하기 단축키" /><Button Content="말하기 단축키 끄기" Style="{StaticResource SecondaryButton}" Padding="10,6" HorizontalAlignment="Left" Margin="0,7,0,0" Click="DisableWakeHotkey_Click" /></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="중지 단축키" Style="{StaticResource FieldLabel}" /><TextBox x:Name="StopHotkeyInput" IsReadOnly="True" Style="{StaticResource Field}" PreviewKeyDown="HotkeyInput_PreviewKeyDown" AutomationProperties.Name="중지 단축키" /><Button Content="기본 단축키로" Style="{StaticResource SecondaryButton}" Padding="10,6" HorizontalAlignment="Left" Margin="0,7,0,0" Click="ResetHotkeys_Click" /></StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="HotkeyFeedback" Style="{StaticResource HelpText}" Margin="0,7,0,0" />
                                        <TextBlock Text="알림 위치" Style="{StaticResource FieldLabel}" Margin="0,17,0,7" /><ComboBox x:Name="OverlayPositionInput" AutomationProperties.Name="알림 위치"><ComboBoxItem Content="가운데" Tag="center" /><ComboBoxItem Content="아래 가운데" Tag="bottomCenter" /><ComboBoxItem Content="오른쪽 아래" Tag="bottomRight" /><ComboBoxItem Content="왼쪽 아래" Tag="bottomLeft" /><ComboBoxItem Content="위 가운데" Tag="top" /></ComboBox>
                                        <TextBlock Text="알림을 표시할 화면" Style="{StaticResource FieldLabel}" Margin="0,14,0,7" /><ComboBox x:Name="OverlayScreenInput" DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.Name="알림 모니터" />
                                        <CheckBox x:Name="IdleOrbInput" Content="듣기 대기 중에도 작은 표시 유지" Margin="0,14,0,0" />
                                        <Button Content="알림 위치 미리 보기" Style="{StaticResource SecondaryButton}" Padding="12,7" HorizontalAlignment="Left" Margin="0,12,0,0" Click="PreviewOverlay_Click" />
                                    </StackPanel>
                                </Expander>
                                <Expander Header="호칭과 인사" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,24">
                                    <StackPanel Margin="0,18,0,0" TextElement.FontWeight="Normal" TextElement.FontSize="12">
                                        <TextBlock Text="나를 부를 호칭" Style="{StaticResource FieldLabel}" /><TextBox x:Name="UserNameInput" Style="{StaticResource Field}" AutomationProperties.Name="사용자 호칭" />
                                        <TextBlock Text="인사 화면" Style="{StaticResource FieldLabel}" Margin="0,14,0,7" /><ComboBox x:Name="GreetingStyleInput" AutomationProperties.Name="인사 화면 종류"><ComboBoxItem Content="빛나는 원형 화면" Tag="reactor" /><ComboBoxItem Content="차분한 화면" Tag="calm" /><ComboBoxItem Content="작은 알림만" Tag="card" /></ComboBox>
                                        <TextBlock Text="인사를 시작하는 말 (한 줄에 하나, 비우면 기본 인사말)" Style="{StaticResource FieldLabel}" Margin="0,14,0,7" /><TextBox x:Name="GreetingPhrasesInput" Style="{StaticResource Field}" AcceptsReturn="True" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="인사 호출 문장" />
                                        <TextBlock Text="인사말 · {user}는 내 호칭, {assistant}는 비서 이름" Style="{StaticResource FieldLabel}" Margin="0,14,0,7" /><TextBox x:Name="GreetingTextInput" Style="{StaticResource Field}" TextWrapping="Wrap" AutomationProperties.Name="인사말" />
                                        <TextBlock Text="화면 제목과 부제 (비우면 자동)" Style="{StaticResource FieldLabel}" Margin="0,14,0,7" /><TextBox x:Name="GreetingTitleInput" Style="{StaticResource Field}" AutomationProperties.Name="인사 화면 제목" /><TextBox x:Name="GreetingSubtitleInput" Style="{StaticResource Field}" Margin="0,7,0,0" AutomationProperties.Name="인사 화면 부제" />
                                        <TextBlock Text="인사할 때 열 웹 주소 (한 줄에 하나)" Style="{StaticResource FieldLabel}" Margin="0,14,0,7" /><TextBox x:Name="GreetingUrlsInput" Style="{StaticResource Field}" AcceptsReturn="True" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="인사 웹 주소" />
                                        <TextBlock Text="인사할 때 열 앱 (여러 개 선택 가능)" Style="{StaticResource FieldLabel}" Margin="0,14,0,7" /><ListBox x:Name="GreetingAppsInput" SelectionMode="Multiple" DisplayMemberPath="Label" Height="120" AutomationProperties.Name="인사 앱 목록" />
                                        <TextBlock Text="미리 보기에서는 웹사이트나 앱을 열지 않습니다." Style="{StaticResource HelpText}" />
                                        <Button Content="인사 미리 보기" Style="{StaticResource SecondaryButton}" Padding="12,7" HorizontalAlignment="Left" Margin="0,12,0,0" Click="PreviewGreeting_Click" />
                                    </StackPanel>
                                </Expander>
