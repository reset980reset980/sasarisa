<Window x:Class="VoiceAssistant.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자비스 · 듣는 중" Width="360" SizeToContent="Height" MaxHeight="300"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False">
    <Border x:Name="RootBorder" Background="#F5172338" BorderBrush="#485A78" BorderThickness="1" CornerRadius="17" Padding="17,16,17,14" Margin="5" MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Grid><Grid x:Name="CardPanel">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Width="31" Height="31" Margin="0,0,11,0"><Ellipse Fill="#315DE7" /><Ellipse Width="12" Height="12" Fill="#ECF1FF" /></Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="OverlayTitle" Text="듣고 있어요" Foreground="White" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="OverlayBrand" Text="자비스 · Windows" Foreground="#9BAEC9" FontSize="9" Margin="0,2,0,0" MaxHeight="28" TextTrimming="CharacterEllipsis" /></StackPanel>
                <Button Grid.Column="2" Content="×" Click="Hide_Click" Background="Transparent" BorderThickness="0" Foreground="#A5B6CE" FontSize="21" Padding="8,0" Cursor="Hand" ToolTip="작은 창 숨기기" Focusable="False" />
            </Grid>
            <TextBlock x:Name="OverlayText" Grid.Row="1" Text="편하게 말씀해 주세요." Foreground="#E1E8F4" FontSize="12" LineHeight="20" Margin="0,13,0,14" MaxHeight="140" TextTrimming="CharacterEllipsis" />
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="OverlayDot" Fill="#70D1B2" Width="5" Height="5" Margin="0,0,7,0" /><TextBlock x:Name="OverlayState" Text="음성을 기다리고 있어요" Foreground="#9BAEC9" FontSize="10" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="말하기" Click="Wake_Click" Style="{StaticResource ActionButton}" FontSize="10" Padding="10,6" Focusable="False" /><Button Content="중지" Click="Stop_Click" Style="{StaticResource ActionButton}" Background="#35465F" BorderBrush="#35465F" FontSize="10" Padding="10,6" Margin="6,0,0,0" Focusable="False" /></StackPanel>
            </Grid>
        </Grid>
        <Button x:Name="IdleButton" Visibility="Collapsed" Width="48" Height="48" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" Click="Wake_Click" ToolTip="비서가 듣기 대기 중입니다. 눌러서 말하기">
            <Grid><Ellipse Fill="#315DE7" /><Ellipse Width="19" Height="19" Fill="#ECF1FF" /><Ellipse Width="7" Height="7" Fill="#315DE7" Margin="10,0,0,0" /></Grid>
        </Button></Grid>
    </Border>
</Window>
