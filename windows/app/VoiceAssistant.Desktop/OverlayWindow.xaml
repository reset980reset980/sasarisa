<Window x:Class="VoiceAssistant.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.43F0EBBD74099E4BB24BECB1}" Width="360" SizeToContent="Height" MaxHeight="300"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False">
    <Border x:Name="RootBorder" Background="#F5172338" BorderBrush="#485A78" BorderThickness="1" CornerRadius="17" Padding="17,16,17,14" Margin="5" MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Grid><Grid x:Name="CardPanel">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Width="31" Height="31" Margin="0,0,11,0"><Ellipse Fill="#315DE7" /><Ellipse Width="12" Height="12" Fill="#ECF1FF" /></Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="OverlayTitle" Text="{DynamicResource Ui.D090B48889B87FA10DB0AA5F}" Foreground="White" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="OverlayBrand" Text="{DynamicResource Ui.C6CF941D50A7EAD7C2FB55DA}" Foreground="#9BAEC9" FontSize="9" Margin="0,2,0,0" MaxHeight="28" TextTrimming="CharacterEllipsis" /></StackPanel>
                <Button Grid.Column="2" Content="×" Click="Hide_Click" Background="Transparent" BorderThickness="0" Foreground="#A5B6CE" FontSize="21" Padding="8,0" Cursor="Hand" ToolTip="{DynamicResource Ui.910A8D35CA629376F659FC4C}" Focusable="False" />
            </Grid>
            <TextBlock x:Name="OverlayText" Grid.Row="1" Text="{DynamicResource Ui.1AD599B52405D30AFDE4181D}" Foreground="#E1E8F4" FontSize="12" LineHeight="20" Margin="0,13,0,14" MaxHeight="140" TextTrimming="CharacterEllipsis" />
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="OverlayDot" Fill="#70D1B2" Width="5" Height="5" Margin="0,0,7,0" /><TextBlock x:Name="OverlayState" Text="{DynamicResource Ui.6014EE5A1CD636F7E1EAC240}" Foreground="#9BAEC9" FontSize="10" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource Ui.02BEE4644FBA56594751D49F}" Click="Wake_Click" Style="{StaticResource ActionButton}" FontSize="10" Padding="10,6" Focusable="False" /><Button Content="{DynamicResource Ui.92CDEF3C5BC09F842A88991D}" Click="Stop_Click" Style="{StaticResource ActionButton}" Background="#35465F" BorderBrush="#35465F" FontSize="10" Padding="10,6" Margin="6,0,0,0" Focusable="False" /></StackPanel>
            </Grid>
        </Grid>
        <Button x:Name="IdleButton" Visibility="Collapsed" Width="48" Height="48" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" Click="Wake_Click" ToolTip="{DynamicResource Ui.93C0081C7C5EF4E3860D13BE}">
            <Grid><Ellipse Fill="#315DE7" /><Ellipse Width="19" Height="19" Fill="#ECF1FF" /><Ellipse Width="7" Height="7" Fill="#315DE7" Margin="10,0,0,0" /></Grid>
        </Button></Grid>
    </Border>
</Window>
